rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ================= LANDING CREATOR =================
    // Todo lo que NO está en la carpeta "sot" queda igual que hoy (público).
    match /{folder}/{allPaths=**} {
      allow read, write: if folder != 'sot';
    }

    // ================== SOT COACHING ===================
    function sotStaff() {
      return request.auth != null && (
        firestore.exists(/databases/(default)/documents/sot_coaches/$(request.auth.uid))
        || (firestore.exists(/databases/(default)/documents/sot_users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/sot_users/$(request.auth.uid)).data.role in ['coach', 'superadmin']
            && firestore.get(/databases/(default)/documents/sot_users/$(request.auth.uid)).data.active == true)
      );
    }

    match /sot/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if sotStaff() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if sotStaff();
    }
  }
}
